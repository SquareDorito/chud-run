# Optional: Public URL of your deployed app (used for Open Graph link previews)
# NEXT_PUBLIC_SITE_URL=https://chudrun.kennoh.xyz

# Optional: Google Places API (New) key to rank food destinations by live star ratings & review counts
# Without this key, ChudRun falls back to OpenStreetMap Overpass + Nominatim.
# GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY

# Optional: Valhalla pedestrian routing endpoint for cost-weighted walkway/hill routing
# When unset or unavailable, ChudRun automatically falls back to OSRM foot routing.
# Example: VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# VALHALLA_URL=

# Optional: Custom map tile URL if you want to use a paid provider (Mapbox, Stadia, Thunderforest, etc.)
# By default, ChudRun uses OpenStreetMap tiles which require NO API key.
# Example for Mapbox:
# NEXT_PUBLIC_MAP_TILES_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_MAPBOX_TOKEN
